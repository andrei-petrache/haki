# Haki frontend server, as a template. At container start the image's
# entrypoint renders it to /etc/nginx/conf.d/default.conf (included inside the
# http { } block), substituting only the environment variables listed in
# NGINX_ENVSUBST_FILTER (see the Dockerfile): nginx's own variables are left
# alone.

# Login, signup, a password change and deleting the account run Argon2
# (64 MiB each, deliberately slow), so they are rate limited per client IP,
# in one shared budget. The last two also check the current password:
# limited, a stolen token cannot guess it at full speed. Only those
# requests count, by method and path: GET /auth/me (the profile) and
# PUT /auth/me (settings) stay unlimited. An empty key is never limited.
#
# The path is $uri as limit_req sees it: inside the limited location below,
# after its rewrite, so without /api, and normalized like the location
# match itself (slashes merged, %XX decoded). Never $request_uri: raw, it
# lets /api//auth/login or /api/auth/%6cogin reach the location without
# matching here, so without a limit.
map "$request_method:$uri" $auth_limit_key {
    ~^POST:/auth/(login|signup)$    $binary_remote_addr;
    PUT:/auth/me/password           $binary_remote_addr;
    DELETE:/auth/me                 $binary_remote_addr;
    default                         "";
}
# 5 requests per minute per IP; 10 MB of state tracks ~160,000 addresses
limit_req_zone $auth_limit_key zone=auth:10m rate=5r/m;

# Retry-After on 429 responses and on the 503 that replaces an unreachable
# backend (an empty value sends no header). The backend's own 503 already
# carries one, so $backend_unavailable tells the two apart.
map "$status:$backend_unavailable" $retry_after {
    ~^429:  60;
    503:1   5;
    default "";
}

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/haki;
    index index.html;

    # Basic security headers. Kept at server level only: a location with its
    # own add_header would silently drop these, which is why caching below
    # uses "expires" instead of add_header.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Only this origin's own files run, style, load or connect: the build has
    # no inline script or style (fonts are bundled, React sets styles through
    # the DOM, which CSP allows), so a script injected into a page cannot
    # run or send data elsewhere. base-uri and form-action are not covered by
    # default-src; frame-ancestors replaces X-Frame-Options in new browsers.
    # Checked by scripts/check-rate-limit.sh, and every e2e run fails on a
    # violation (layout.e2e.ts).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header Retry-After $retry_after always;

    limit_req_status 429;
    limit_req_log_level warn;

    # The backend's name is resolved per request (cached 30 s), not once at
    # start: Nginx then starts even before the name resolves (e.g. a cold
    # cluster start, DNS not up yet), and only the requests made meanwhile
    # get 503 (see error_page below). The entrypoint fills
    # NGINX_LOCAL_RESOLVERS from /etc/resolv.conf: CoreDNS in Kubernetes,
    # Docker's DNS in Compose.
    # This resolver ignores /etc/hosts and resolv.conf's search domains, so
    # in Kubernetes BACKEND_URL needs the full name
    # (http://haki-backend.<namespace>.svc.cluster.local:8000).
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;
    resolver_timeout 5s;
    # A variable in proxy_pass is what makes Nginx resolve at request time
    set $backend ${BACKEND_URL};
    set $backend_unavailable "";

    # An unreachable backend (no endpoints while every pod fails readiness,
    # a name that does not resolve, a refused connection) makes Nginx itself
    # answer 502, which reads as a broken gateway. Answer what the backend
    # answers when the database is down instead: 503, the same JSON body and
    # Retry-After: 5, so clients know to try again shortly. Only Nginx's own
    # 502s: without proxy_intercept_errors, the backend's responses pass as
    # they are.
    error_page 502 =503 @backend_unavailable;

    # The client's real IP, for the rate limit and the logs, when a proxy
    # (the Gateway in Kubernetes) stands in front: from a REAL_IP_FROM
    # address, $remote_addr becomes the last X-Forwarded-For entry that is
    # not itself trusted, i.e. the client as that proxy saw it. Entries a
    # client writes itself sit further left and are ignored. From any other
    # address the header is ignored, so nobody can spoof their IP to escape
    # the limit. The default "unix:" trusts only UNIX sockets, which this
    # server does not listen on: nobody (Compose, nothing in front).
    set_real_ip_from ${REAL_IP_FROM};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # Compress text responses (text/html is always included)
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types text/css text/plain application/javascript application/json image/svg+xml;

    # Proxy settings shared by both /api locations below (inherited, since
    # neither location sets its own proxy_set_header)
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Same contract as the Vite dev proxy: /api/foods -> backend /foods.
    # With a variable, proxy_pass no longer replaces the /api/ prefix, so
    # rewrite strips it; the backend gets the changed path and the query
    # string.
    location /api/ {
        rewrite ^/api(/.*)$ $1 break;
        proxy_pass $backend;
    }

    # Login, signup, password change and account deletion (the map above
    # picks which methods count, from $uri after this rewrite): a burst of 5
    # at once, then one every 12 s, else 429. A regex location wins over the
    # /api/ prefix above.
    location ~ ^/api/auth/(login|signup|me|me/password)$ {
        limit_req zone=auth burst=5 nodelay;
        rewrite ^/api(/.*)$ $1 break;
        proxy_pass $backend;
    }

    location @backend_unavailable {
        set $backend_unavailable 1;
        default_type application/json;
        return 503 '{"detail":"Service temporarily unavailable, try again shortly"}\n';
    }

    # Health of Nginx itself, for the Compose healthcheck and Kubernetes
    # probes. Answered here, without the backend: a backend outage must not
    # restart the frontend or take it out of service. Not logged, since
    # probes call it every few seconds.
    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Vite names these files after a hash of their content: a new build gets
    # new names, so browsers may keep them for a year without asking again.
    location /assets/ {
        expires 1y;
        # A missing asset is a 404, not index.html served as JavaScript
        try_files $uri =404;
    }

    # index.html points to the current asset names, so browsers must check
    # for a new version every time (no-cache = revalidate, not "never store")
    location = /index.html {
        expires -1;
    }

    # Unknown paths get the app, ready for client-side routing later
    location / {
        try_files $uri $uri/ /index.html;
    }
}
