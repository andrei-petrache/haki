# Allowlist: ignore everything, then let in only what the build needs.
# node_modules and dist are rebuilt inside the image, never copied in.
*
!package.json
!package-lock.json
!index.html
!vite.config.ts
!tsconfig.json
!tsconfig.app.json
!tsconfig.node.json
!public/
!src/
!nginx.conf

# Never send these, even if they appear inside an allowed directory
**/.env
**/.env.*
